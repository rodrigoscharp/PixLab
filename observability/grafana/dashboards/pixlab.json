{
  "uid": "pixlab",
  "title": "PixLab — idempotência e conciliação",
  "tags": [
    "pixlab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "ledger_imbalance (sempre 0)",
      "description": "Σ débitos − Σ créditos do ledger inteiro. Qualquer valor ≠ 0 é bug.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1e-06
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "abs(ledger_imbalance)"
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Transações desbalanceadas",
      "description": "",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1e-06
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ledger_unbalanced_transactions"
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Inbox em quarentena",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "inbox_events{status=\"QUARANTINED\"}"
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Lag da inbox (s)",
      "description": "",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "inbox_lag_seconds"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Eventos recebidos vs duplicatas descartadas",
      "description": "PIX-DUP e PIX-DUP-CONC aparecem como duplicatas descartadas pela constraint UNIQUE da inbox.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source) (rate(webhook_received_total[1m]))",
          "legendFormat": "novos {{source}}"
        },
        {
          "refId": "B",
          "expr": "sum by (source) (rate(webhook_duplicate_discarded_total[1m]))",
          "legendFormat": "duplicatas {{source}}"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Inbox por estado",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "inbox_events",
          "legendFormat": "{{status}}"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Injeções de caos por cenário",
      "description": "Cada cenário do catálogo injetado pelo psp-simulator.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (scenario) (increase(psp_chaos_injections_total[1m]))",
          "legendFormat": "{{scenario}}"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Entregas de webhook do PSP",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(psp_webhook_deliveries_total[1m]))",
          "legendFormat": "{{result}}"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Webhooks rejeitados",
      "description": "PIX-BAD-AUTH: assinatura inválida, rejeitado antes de qualquer efeito.",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(webhook_rejected_total[1m]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Divergências da conciliação",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (increase(recon_divergence_total[5m]))",
          "legendFormat": "{{result}}"
        }
      ],
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Latência HTTP p99",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, application, uri) (rate(http_server_requests_seconds_bucket[1m])))",
          "legendFormat": "{{application}} {{uri}}"
        }
      ],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Outbox não publicada",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "outbox_unpublished",
          "legendFormat": "pendentes"
        }
      ],
      "id": 12
    }
  ]
}